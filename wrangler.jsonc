{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "custom-worker.js",
	"name": "wlyl-tutor",
	// #407 tutor preview: a separate Worker so the main wlyl preview is untouched.
	// Supabase (and its pooler) is in AWS ap-south-1, Mumbai. Pin the Worker next to it: every
	// request makes several sequential DB round trips, so DB distance dominates, not visitor distance.
	// Smart placement never moved a low-traffic Worker (it ran in Marseille).
	"placement": { "region": "aws:ap-south-1" },
	"compatibility_date": "2026-09-18",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	// Phase 1: workers.dev URL only, no custom domain/zone routes yet.
	"workers_dev": true,
	// Supabase via Hyperdrive, query caching disabled (cached reads would go stale after writes).
	"hyperdrive": [{ "binding": "HYPERDRIVE", "id": "9a23f4ac1a884291ae1667aa63bbad10" }],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// No crons: the main wlyl Worker runs them; a second copy would run billing/backups twice.
	"triggers": { "crons": [] },
	"services": [
		{
			// Self-reference service binding, the service name must match the worker name
			// see https://opennext.js.org/cloudflare/caching
			"binding": "WORKER_SELF_REFERENCE",
			"service": "wlyl-tutor"
		}
	],
	"images": {
		// Enable image optimization
		// see https://opennext.js.org/cloudflare/howtos/image
		"binding": "IMAGES"
	}
}
