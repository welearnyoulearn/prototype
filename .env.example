# ── Database (Supabase — use individual params to avoid URL encoding issues) ──
PGHOST=aws-1-ap-south-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=your-password

# ── OR use a full connection string (local dev) ──
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wlyl

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
SETUP_SECRET=wlyl-setup-2024

# ── App URL ───────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=WLYL Team <your-email@gmail.com>

# ── File uploads (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── Push notifications (Firebase Cloud Messaging) ────────────────────────────
# Service-account JSON from Firebase console → Project settings → Service accounts → Generate
# new private key. Paste the JSON on one line, or base64 of it. Unset = push is off (safe).
# FIREBASE_SERVICE_ACCOUNT={"project_id":"your-project","client_email":"firebase-adminsdk-xxxx@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
# Parent mobile app (Expo): pushes go through Expo's service and need no key here. Only set this if
# "enhanced push security" is turned on for the Expo project (#133).
# EXPO_ACCESS_TOKEN=

# Web push (browser side). Firebase console → Project settings → General → Your apps → Web app, and
# Cloud Messaging → Web Push certificates → Generate key pair (that is the VAPID key). All public values.
# Leave any of them unset and the bell simply never offers push.
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── Parent app (wlyl-parent-app, an installed PWA that proxies /api/* to this platform) ────────
# Exact origins, comma-separated, whose sign-in / sign-out / password requests the cross-site guard accepts.
# Without the parent app's origin here, every parent login through the app is refused with 403.
# TRUSTED_APP_ORIGINS=https://parent.example.com,http://localhost:3002

# ── AI (optional — not needed for wlylV1) ────────────────────────────────────
# GROQ_API_KEY=your_groq_key

# ── Backup: Vercel Cron → Cloudflare R2 (daily data-only backup + restore) ────
# CRON_SECRET: random string; Vercel Cron auto-sends it as `Authorization: Bearer`.
# Also required to call POST /api/restore manually.
CRON_SECRET=change-this-to-a-long-random-string
# Cloudflare R2 (S3-compatible). Create a bucket + an "Object Read & Write" token.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key

# ── WhatsApp (Meta Cloud API, platform-owned number) — leave token/phone empty to log messages without sending ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_TEMPLATE_LANG=en

# ── Website visitors (Cloudflare Web Analytics, cookieless) — public pages only; unset = no beacon ──
# NEXT_PUBLIC_CF_WEB_ANALYTICS_TOKEN=
