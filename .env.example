# ── Database (Supabase — use individual params to avoid URL encoding issues) ──
PGHOST=aws-1-ap-south-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=your-password

# ── OR use a full connection string (local dev) ──
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wlyl

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
SETUP_SECRET=wlyl-setup-2024

# ── App URL ───────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=WLYL Team <your-email@gmail.com>

# ── File uploads (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI (optional — not needed for wlylV1) ────────────────────────────────────
# GROQ_API_KEY=your_groq_key

# ── Analytics & Search Console (all optional; each activates only when set) ────
# Google Analytics 4 — Measurement ID (Admin → Data Streams). Public (browser).
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Microsoft Clarity — Project ID (Settings → Overview). Public (browser).
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
# Google Search Console — the token from the "HTML tag" verification method
# (the content="..." value, not the full tag). Server-only; rendered into <head>.
GOOGLE_SITE_VERIFICATION=your-google-site-verification-token
