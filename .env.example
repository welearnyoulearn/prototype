# ── Database (Supabase — use individual params to avoid URL encoding issues) ──
PGHOST=aws-1-ap-south-1.pooler.supabase.com
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres.your-project-ref
PGPASSWORD=your-password

# ── OR use a full connection string (local dev) ──
# DATABASE_URL=postgresql://postgres:password@localhost:5432/wlyl

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production
SETUP_SECRET=wlyl-setup-2024

# ── App URL ───────────────────────────────────────────────────────────────────
APP_URL=http://localhost:3000

# ── Email (Gmail SMTP) ────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=WLYL Team <your-email@gmail.com>

# ── File uploads (Cloudinary) ─────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ── AI (optional — not needed for wlylV1) ────────────────────────────────────
# GROQ_API_KEY=your_groq_key

# ── Backup: Vercel Cron → Cloudflare R2 (daily data-only backup + restore) ────
# CRON_SECRET: random string; Vercel Cron auto-sends it as `Authorization: Bearer`.
# Also required to call POST /api/restore manually.
CRON_SECRET=change-this-to-a-long-random-string
# Cloudflare R2 (S3-compatible). Create a bucket + an "Object Read & Write" token.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
